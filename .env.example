# Backend
SECRET_KEY=please-change-this-secret-key
JWT_SECRET_KEY=please-change-this-jwt-secret
JWT_EXPIRES_HOURS=24
CORS_ORIGINS=http://localhost:5173,http://localhost

# Docker 宿主机端口，可保持默认
BACKEND_PORT=5000
DEV_FRONTEND_PORT=5173
PROD_FRONTEND_PORT=80

# SQLite
# 默认使用 backend/data/bullet_journal.db。
# Docker Compose 会自动使用容器内的 /app/data/bullet_journal.db。
# 如需自定义本地路径，取消下面任一配置并修改：
# DATABASE_URL=sqlite:///data/bullet_journal.db
# SQLITE_PATH=E:\BulletJournal\backend\data\bullet_journal.db

# Default admin account created on first startup
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=Admin123456
